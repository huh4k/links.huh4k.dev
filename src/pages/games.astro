---
import BaseLayout from '../layouts/BaseLayout.astro';
import SteamPresence from '../components/steam/SteamPresence';
import GameFilter from '../components/steam/GameFilter';
import CS2StatsCard from '../components/steam/CS2StatsCard.astro';
import { getSteamId64, getTopPlayedGames } from '../lib/steam';

const steamId = getSteamId64();
const steamProfileUrl = `https://steamcommunity.com/profiles/${steamId}`;
const allGames = await getTopPlayedGames(50);
---

<BaseLayout
  title="Games — huh4k"
  description="What huh4k plays: live Steam status, Counter-Strike 2 Premier rating and lifetime playtime."
  currentPath="/games"
>
  <header class="pb-14 sm:pb-20">
    <p class="eyebrow rise" style="--i:0">steam · leetify</p>
    <h1 class="display rise mt-5 text-[clamp(4rem,15vw,11rem)] leading-[0.82]" style="--i:1">
      games<span class="text-signal">.</span>
    </h1>
    <p class="rise mt-8 max-w-xl text-[clamp(1.25rem,2.4vw,1.75rem)] leading-tight text-ash" style="--i:2">
      mostly counter-strike. the rest is whatever i got stuck in this month.
    </p>
  </header>

  <section class="border-t border-rule pt-5">
    <SteamPresence client:idle variant="card" />
  </section>

  <section class="mt-24 sm:mt-36">
    <h2 class="eyebrow mb-10 border-t border-rule pt-5">premier</h2>
    <CS2StatsCard steamId={steamId} />
  </section>

  <section class="mt-24 sm:mt-36">
    <header class="mb-10 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-t border-rule pt-5">
      <h2 class="display text-[clamp(2rem,4.5vw,3.25rem)]">library</h2>
      <div class="flex gap-6 pb-1 text-[15px] text-ash">
        <a href="/leetify" target="_blank" rel="noopener noreferrer" class="u-link hover:text-bone">leetify ↗</a>
        <a href={steamProfileUrl} target="_blank" rel="noopener noreferrer" class="u-link hover:text-bone">steam ↗</a>
      </div>
    </header>
    <GameFilter client:load games={allGames} />
  </section>
</BaseLayout>
