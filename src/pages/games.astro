---
import BaseLayout from '../layouts/BaseLayout.astro';
import SteamPresence from '../components/steam/SteamPresence';
import GameGrid from '../components/steam/GameGrid.astro';
import { getSteamId64 } from '../lib/steam';

const steamId = getSteamId64();
const steamProfileUrl = `https://steamcommunity.com/profiles/${steamId}`;
---

<BaseLayout
  title="Gaming Shelf & Steam Library — huh4k"
  description="huh4k's Steam gaming presence, top played titles, and playtime statistics."
  currentPath="/games"
>
  <div class="space-y-10">
    <!-- Back to Hub Navigation -->
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-400 hover:text-white transition-colors"
      >
        <span>←</span>
        <span>Back to Links Hub</span>
      </a>
    </div>

    <!-- Page Header Section -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-blue-400 uppercase tracking-wider">
        <span>02 // Valve Steam Integration</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        Gaming Library & Steam Activity
      </h1>
      <p class="text-base text-zinc-400 max-w-2xl leading-relaxed">
        Live presence, favorite games, and playtime statistics fetched directly from the Steam Web API.
      </p>
    </div>

    <!-- Live Steam Presence Showcase Banner -->
    <div class="space-y-3">
      <h2 class="text-sm font-mono uppercase tracking-wider text-zinc-400">Live Status</h2>
      <SteamPresence client:idle variant="card" />
    </div>

    <!-- Top Played Games Grid -->
    <div class="space-y-6 pt-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-white tracking-tight">Top Played & Featured Titles</h2>
          <p class="text-xs font-mono text-zinc-500">
            Sorted by total logged playtime. Data cached for 24h to respect Valve rate limits.
          </p>
        </div>

        <a
          href={steamProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-dark-border bg-dark-card hover:border-zinc-600 hover:bg-dark-card-hover text-xs font-mono text-zinc-200 hover:text-white transition-colors self-start sm:self-auto"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path
              d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.005.105.005.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.704L.439 15.05C1.724 20.245 6.41 24 11.979 24c6.627 0 12-5.373 12-12s-5.373-12-12-12z"
            ></path>
          </svg>
          <span>View Steam Profile ↗</span>
        </a>
      </div>

      <GameGrid showStats={true} limit={12} />
    </div>
  </div>
</BaseLayout>
