---
import BaseLayout from '../layouts/BaseLayout.astro';
import SteamPresence from '../components/steam/SteamPresence';
import GameGrid from '../components/steam/GameGrid.astro';
import CS2StatsCard from '../components/steam/CS2StatsCard.astro';
import { getSteamId64 } from '../lib/steam';

const steamId = getSteamId64();
const steamProfileUrl = `https://steamcommunity.com/profiles/${steamId}`;
---

<BaseLayout
  title="Gaming Shelf & Steam Library — huh4k"
  description="huh4k's Steam gaming presence, Counter-Strike 2 Premier rating, and lifetime playtime statistics."
  currentPath="/games"
>
  <div class="space-y-10">
    <!-- Back to Hub Navigation -->
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-400 hover:text-white transition-colors"
      >
        <span>←</span>
        <span>Back to Links Hub</span>
      </a>

      <div class="flex items-center gap-3 text-xs font-mono">
        <a
          href="/"
          class="text-zinc-400 hover:text-white transition-colors"
        >
          links.huh4k.dev
        </a>
        <span class="text-zinc-600">•</span>
        <a
          href="/leetify"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#BF3B68] hover:text-[#d64c7b] transition-colors"
        >
          /leetify ↗
        </a>
      </div>
    </div>

    <!-- Page Header Section -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-blue-400 uppercase tracking-wider">
        <span>02 // Valve Steam & Leetify Integration</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        Gaming Library & Activity
      </h1>
      <p class="text-base text-zinc-400 max-w-2xl leading-relaxed">
        Real-time Steam activity, Counter-Strike 2 competitive metrics, and lifetime playtime statistics.
      </p>
    </div>

    <!-- Live Status & CS2 Performance Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
      <!-- Live Steam Presence Widget -->
      <div class="space-y-3 flex flex-col justify-between">
        <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-400">Live Steam Status</h2>
        <SteamPresence client:idle variant="card" className="h-full flex flex-col justify-between" />
      </div>

      <!-- Counter-Strike 2 Leetify Performance Card -->
      <div class="space-y-3">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#BF3B68]">CS2 Competitive Rating</h2>
        <CS2StatsCard />
      </div>
    </div>

    <!-- Top Played Games Grid -->
    <div class="space-y-6 pt-6 border-t border-dark-border/60">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-white tracking-tight">Top Played & Featured Titles</h2>
          <p class="text-xs font-mono text-zinc-500">
            Sorted by total logged playtime. Data cached for 24h to respect Valve rate limits.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/leetify"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-[#BF3B68]/35 bg-[#BF3B68]/15 hover:border-[#BF3B68]/60 hover:bg-[#BF3B68]/25 text-xs font-mono text-[#BF3B68] hover:text-[#d64c7b] transition-colors"
          >
            <span>Leetify Stats</span>
            <span>↗</span>
          </a>

          <a
            href={steamProfileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-dark-border bg-dark-card hover:border-zinc-600 hover:bg-dark-card-hover text-xs font-mono text-zinc-200 hover:text-white transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path
                d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.005.105.005.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.704L.439 15.05C1.724 20.245 6.41 24 11.979 24c6.627 0 12-5.373 12-12s-5.373-12-12-12zM8.366 18.253l-1.92-.794c.264.44.662.779 1.15.957.962.35 2.03-.133 2.38-1.096.175-.483.136-.998-.073-1.424l-1.537 2.357zm7.576-6.315c-1.656 0-3.003-1.345-3.003-3.001 0-1.655 1.347-3.002 3.003-3.002 1.654 0 3.002 1.347 3.002 3.002 0 1.656-1.348 3.001-3.002 3.001zm-5.467 4.108c-.287.41-.74.686-1.266.746l1.503-2.306c.015.012.03.024.045.039.467.466.52 1.187-.282 1.521z"
              ></path>
            </svg>
            <span>Steam Profile ↗</span>
          </a>
        </div>
      </div>

      <GameGrid showStats={true} limit={12} />
    </div>
  </div>
</BaseLayout>
