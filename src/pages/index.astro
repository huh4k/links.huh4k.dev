---
import BaseLayout from '../layouts/BaseLayout.astro';
import SteamPresence from '../components/steam/SteamPresence';
import SocialLinks from '../components/SocialLinks.astro';
import GameGrid from '../components/steam/GameGrid.astro';
import CS2StatsCard from '../components/steam/CS2StatsCard.astro';
import { SITE_CONFIG } from '../lib/config';
import { getSteamId64 } from '../lib/steam';

const steamId = getSteamId64();
const steamProfileUrl = `https://steamcommunity.com/profiles/${steamId}`;
---

<BaseLayout
  title={`${SITE_CONFIG.author.name} (${SITE_CONFIG.name}) — Steam & Leetify Hub`}
  description={SITE_CONFIG.description}
  currentPath="/"
>
  <div class="space-y-12 sm:space-y-16">
    <!-- Hero Profile Section -->
    <section class="rounded-2xl border border-dark-border bg-gradient-to-br from-dark-card to-[#0d0f17] p-6 sm:p-10 relative overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none"></div>

      <div class="relative z-10 space-y-6">
        <!-- Live Steam Presence Status Pill -->
        <div class="flex flex-wrap items-center gap-3">
          <SteamPresence client:idle variant="badge" />
        </div>

        <div class="space-y-2">
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
            {SITE_CONFIG.author.name}
          </h1>
          <p class="text-base sm:text-lg text-zinc-300 font-mono">
            {SITE_CONFIG.name} <span class="text-zinc-500">•</span> {SITE_CONFIG.author.status}
          </p>
        </div>

        <p class="text-sm sm:text-base text-zinc-400 max-w-xl leading-relaxed">
          Verified Steam gaming presence, Counter-Strike 2 Premier rating, and Leetify analytics.
        </p>

        <!-- Social Icons Row -->
        <div class="pt-2">
          <SocialLinks showLabels={true} />
        </div>
      </div>
    </section>

    <!-- Essential Quick Links Section -->
    <section id="links" class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-mono uppercase tracking-wider text-blue-400">
          01 // Quick Links
        </h2>
        <span class="text-xs font-mono text-zinc-500">Steam • /links • /leetify</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Steam Profile & Library Card -->
        <a
          href={steamProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl border border-dark-border bg-dark-card p-5 transition-all duration-300 hover:border-sky-500/50 hover:bg-dark-card-hover flex flex-col justify-between gap-4"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-sky-400">Steam Community</span>
              <span class="text-zinc-500 group-hover:text-sky-400 transition-colors">↗</span>
            </div>
            <h3 class="text-lg font-semibold text-white group-hover:text-sky-400 transition-colors">
              Steam Profile
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Steam profile, game library, badges, and shared multiplayer games.
            </p>
          </div>
          <span class="text-xs font-mono text-zinc-500 group-hover:text-zinc-300">Open Steam →</span>
        </a>

        <!-- Links Hub Card -->
        <a
          href="/links"
          class="group rounded-xl border border-dark-border bg-dark-card p-5 transition-all duration-300 hover:border-blue-500/50 hover:bg-dark-card-hover flex flex-col justify-between gap-4"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-blue-400">/links</span>
              <span class="text-zinc-500 group-hover:text-blue-400 transition-colors">→</span>
            </div>
            <h3 class="text-lg font-semibold text-white group-hover:text-blue-400 transition-colors">
              Links Hub
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Official link index for verified profiles and gaming platforms.
            </p>
          </div>
          <span class="text-xs font-mono text-zinc-500 group-hover:text-zinc-300">Browse Links →</span>
        </a>

        <!-- Leetify Card -->
        <a
          href="/leetify"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl border border-dark-border bg-dark-card p-5 transition-all duration-300 hover:border-orange-500/50 hover:bg-dark-card-hover flex flex-col justify-between gap-4"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-orange-400">/leetify</span>
              <span class="text-zinc-500 group-hover:text-orange-400 transition-colors">↗</span>
            </div>
            <h3 class="text-lg font-semibold text-white group-hover:text-orange-400 transition-colors">
              Leetify CS2 Profile
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Counter-Strike 2 Premier rating, Aim rating, and match analytics.
            </p>
          </div>
          <span class="text-xs font-mono text-zinc-500 group-hover:text-zinc-300">View on Leetify →</span>
        </a>
      </div>
    </section>

    <!-- CS2 Rating & Performance Section -->
    <section class="space-y-4 pt-4 border-t border-dark-border/60">
      <div class="flex items-center justify-between">
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-xs font-mono text-orange-400 uppercase tracking-wider">
            <span>02 // Competitive Performance</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
            Counter-Strike 2 Live Metrics
          </h2>
        </div>

        <a
          href="/leetify"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-orange-400 hover:text-orange-300 transition-colors flex items-center gap-1"
        >
          <span>Full Analytics</span>
          <span>↗</span>
        </a>
      </div>

      <CS2StatsCard />
    </section>

    <!-- Top Played Gaming Preview Section -->
    <section class="space-y-6 pt-4 border-t border-dark-border/60">
      <div class="flex items-center justify-between">
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 uppercase tracking-wider">
            <span>03 // Top Played Games</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
            Steam Library Highlights
          </h2>
        </div>

        <a
          href="/games"
          class="text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors flex items-center gap-1"
        >
          <span>View All Games</span>
          <span>→</span>
        </a>
      </div>

      <!-- Top 3 Games -->
      <GameGrid limit={3} />
    </section>
  </div>
</BaseLayout>
