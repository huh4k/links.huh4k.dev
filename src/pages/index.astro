---
import BaseLayout from '../layouts/BaseLayout.astro';
import CS2StatsCard from '../components/steam/CS2StatsCard.astro';
import CS2LoadoutShowcase from '../components/steam/CS2LoadoutShowcase.astro';
import { SITE_CONFIG } from '../lib/config';
import { getSteamId64, getTopPlayedGames } from '../lib/steam';

const steamId = getSteamId64();
const steamProfileUrl = `https://steamcommunity.com/profiles/${steamId}`;
const steamInventoryUrl = `https://steamcommunity.com/profiles/${steamId}/inventory/`;
const topGames = await getTopPlayedGames(3);
const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);

const links = [
  { title: 'Steam', note: 'profile, badges, the whole library', href: steamProfileUrl, external: true },
  { title: 'Leetify', note: 'match stats, aim, who carried', href: '/leetify', external: true },
  { title: 'Inventory', note: 'every skin, real floats, spin them around', href: '/inventory', external: false },
  { title: 'Games', note: 'what i actually play', href: '/games', external: false },
  { title: 'GitHub', note: 'code', href: 'https://github.com/huh4k', external: true },
];
---

<BaseLayout
  title={`${SITE_CONFIG.author.name} — ${SITE_CONFIG.title}`}
  description={SITE_CONFIG.description}
  currentPath="/"
>
  <!-- hero -->
  <section class="overflow-x-clip pb-14 sm:pb-24">
    <p class="eyebrow rise" style="--i:0">counter-strike 2 · software · tools</p>
    <h1
      class="display wordmark rise -ml-[0.035em] mt-5 text-[clamp(5.5rem,24vw,18rem)] leading-[0.78]"
      style="--i:1"
    >
      huh4k<span class="text-signal">.</span>
    </h1>
    <div class="rise mt-9 flex flex-wrap items-end justify-between gap-x-10 gap-y-5" style="--i:2">
      <p class="max-w-xl text-[clamp(1.5rem,3.2vw,2.35rem)] leading-[1.1] tracking-tight">
        links and shit. <span class="text-ash">pronounced <span class="num text-bone">hufk</span>.</span>
      </p>
    </div>
  </section>

  <!-- find me -->
  <section aria-labelledby="find-me">
    <h2 id="find-me" class="eyebrow mb-5">find me</h2>
    <ul class="border-t border-rule">
      {links.map((link, i) => (
        <li class="rise" style={`--i:${i + 3}`}>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="link-row"
          >
            <span class="num link-row-meta w-7 shrink-0 text-[13px] text-ash">0{i + 1}</span>
            <span class="display text-[clamp(2.4rem,7vw,5.25rem)] leading-[0.95]">{link.title}</span>
            <span class="link-row-meta ml-auto hidden max-w-[15rem] text-right text-[15px] leading-snug text-ash md:block">
              {link.note}
            </span>
            <span class="link-row-arrow ml-auto text-2xl leading-none md:ml-0">{link.external ? '↗' : '→'}</span>
          </a>
        </li>
      ))}
      <li class="rise" style={`--i:${links.length + 3}`}>
        <button id="copy-discord-btn" type="button" class="link-row" title="Copy my Discord username">
          <span class="num link-row-meta w-7 shrink-0 text-[13px] text-ash">0{links.length + 1}</span>
          <span class="display text-[clamp(2.4rem,7vw,5.25rem)] leading-[0.95]">Discord</span>
          <span id="discord-btn-text" class="link-row-meta ml-auto hidden max-w-[15rem] text-right text-[15px] leading-snug text-ash md:block">
            huh3k — click to copy
          </span>
          <span class="link-row-arrow ml-auto text-2xl leading-none md:ml-0" aria-hidden="true">⧉</span>
        </button>
      </li>
    </ul>
  </section>

  <!-- the numbers -->
  <section class="mt-24 sm:mt-36" aria-labelledby="numbers">
    <header class="mb-10 flex items-end justify-between gap-6 border-t border-rule pt-5">
      <h2 id="numbers" class="display text-[clamp(2rem,4.5vw,3.25rem)]">the numbers</h2>
      <a href="/leetify" target="_blank" rel="noopener noreferrer" class="u-link pb-1 text-[15px] text-ash hover:text-bone">leetify ↗</a>
    </header>
    <CS2StatsCard steamId={steamId} />
  </section>

  <!-- most played -->
  <section class="mt-24 sm:mt-36" aria-labelledby="played">
    <header class="mb-10 flex items-end justify-between gap-6 border-t border-rule pt-5">
      <h2 id="played" class="display text-[clamp(2rem,4.5vw,3.25rem)]">most played</h2>
      <a href="/games" class="u-link pb-1 text-[15px] text-ash hover:text-bone">all games →</a>
    </header>

    <ul class="grid gap-x-6 gap-y-12 md:grid-cols-3">
      {topGames.map((game, index) => (
        <li>
          <a
            href={game.storeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group block"
          >
            <div class="relative aspect-[460/215] overflow-hidden bg-ink-3">
              <img
                src={game.capsuleUrl || game.headerUrl}
                alt={game.name}
                loading="lazy"
                decoding="async"
                width="460"
                height="215"
                class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
              />
            </div>
            <div class="mt-4 flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="truncate text-[22px] font-semibold leading-tight tracking-tight transition-colors group-hover:text-signal">
                  {game.name}
                </h3>
                <p class="num mt-1 text-[13px] text-ash">{fmt(game.playtimeHours)} hrs</p>
              </div>
              <span class="display outline-text shrink-0 text-5xl leading-none">0{index + 1}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- loadout -->
  <section class="mt-24 sm:mt-36" aria-labelledby="loadout">
    <header class="mb-10 flex items-end justify-between gap-6 border-t border-rule pt-5">
      <h2 id="loadout" class="display text-[clamp(2rem,4.5vw,3.25rem)]">loadout</h2>
      <a href="/inventory" class="u-link pb-1 text-[15px] text-ash hover:text-bone">every skin →</a>
    </header>
    <CS2LoadoutShowcase steamInventoryUrl={steamInventoryUrl} />
  </section>

  <script is:inline>
    function setupDiscordCopy() {
      var btn = document.getElementById('copy-discord-btn');
      var label = document.getElementById('discord-btn-text');
      if (!btn || !label || btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      var original = label.textContent;
      btn.addEventListener('click', async function () {
        var copied = false;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText('huh3k');
            copied = true;
          }
        } catch (e) { /* fall through */ }
        if (!copied) {
          try {
            var el = document.createElement('textarea');
            el.value = 'huh3k';
            el.setAttribute('readonly', '');
            el.style.position = 'absolute';
            el.style.left = '-9999px';
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
          } catch (e) { /* ignore */ }
        }
        label.textContent = 'copied ✓';
        setTimeout(function () { label.textContent = original; }, 1800);
      });
    }
    setupDiscordCopy();
    document.addEventListener('astro:page-load', setupDiscordCopy);
  </script>
</BaseLayout>
