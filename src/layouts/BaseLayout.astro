---
import '../styles/global.css';
import { SITE_CONFIG } from '../lib/config';
import { getSteamId64 } from '../lib/steam';
import SteamPresence from '../components/steam/SteamPresence';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  currentPath = '/',
} = Astro.props;

const steamId = getSteamId64();
const currentYear = new Date().getFullYear();
const isHome = currentPath === '/';
const isGames = currentPath === '/games';
const canonicalUrl = new URL(Astro.url.pathname, SITE_CONFIG.url).href;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090a0f" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph (Embed Previews for Discord, iMessage, and Chat Apps) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/favicon.svg', SITE_CONFIG.url).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-dark-bg text-zinc-100 flex flex-col min-h-screen selection:bg-blue-600 selection:text-white">
    <!-- Navbar Header -->
    <header class="sticky top-0 z-50 w-full border-b border-dark-border/80 bg-dark-bg/90 backdrop-blur-md">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3 sm:gap-4">
        <!-- Brand -->
        <a
          href="/"
          class="group flex items-center gap-2 font-mono text-sm tracking-tight text-zinc-200 hover:text-white transition-colors shrink-0"
          aria-label="huh4k links home"
        >
          <span class="inline-block w-2.5 h-2.5 rounded-sm bg-blue-500 group-hover:scale-110 transition-transform"></span>
          <span class="font-semibold text-zinc-100">huh4k</span>
          <span class="text-zinc-500 hidden min-[400px]:inline">~/links</span>
        </a>

        <!-- Navigation Links -->
        <nav class="flex items-center gap-3 sm:gap-6 text-sm font-medium whitespace-nowrap">
          <a
            href="/"
            class={`transition-colors text-xs sm:text-sm ${isHome ? 'text-white font-semibold' : 'text-zinc-400 hover:text-zinc-200'}`}
          >
            Links
          </a>
          <a
            href="/games"
            class={`transition-colors flex items-center gap-1.5 text-xs sm:text-sm ${isGames ? 'text-white font-semibold' : 'text-zinc-400 hover:text-zinc-200'}`}
          >
            <span>Games</span>
            <span class="hidden sm:inline text-[10px] font-mono px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-400 border border-blue-500/30">
              Steam
            </span>
          </a>
          <a
            href="/leetify"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#BF3B68] hover:text-[#d64c7b] transition-colors inline-flex items-center gap-1 font-mono text-xs font-medium"
          >
            <span>Leetify</span>
            <span class="text-[10px]">↗</span>
          </a>
          <a
            href={`https://steamcommunity.com/profiles/${steamId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-zinc-200 transition-colors hidden sm:inline-flex items-center gap-1 font-mono text-xs"
          >
            <span>Steam</span>
            <span>↗</span>
          </a>
        </nav>

        <!-- Steam Live Presence Widget in Navbar -->
        <div class="hidden sm:flex items-center pl-2 border-l border-dark-border/70 shrink-0">
          <SteamPresence client:load variant="badge" />
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-dark-border/80 bg-[#07080c] py-12 text-sm text-zinc-500">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
        <!-- Status & Socials -->
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <SocialLinks />
          <span class="text-xs font-mono text-zinc-500 hidden sm:inline">•</span>
          <span class="text-xs font-mono text-zinc-400">Steam & Leetify Integration</span>
        </div>

        <!-- Copyright & Tech -->
        <div class="flex items-center gap-3 text-xs font-mono text-zinc-500">
          <span>© {currentYear} {SITE_CONFIG.name}</span>
          <span>•</span>
          <span>Steam + Leetify + Astro</span>
        </div>
      </div>
    </footer>
  </body>
</html>
