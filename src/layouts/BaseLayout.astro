---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import { SITE_CONFIG } from '../lib/config';
import { getSteamId64 } from '../lib/steam';
import SteamPresence from '../components/steam/SteamPresence';
import SocialLinks from '../components/SocialLinks.astro';
import CommandDeck from '../components/CommandDeck';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  currentPath = '/',
} = Astro.props;

const steamId = getSteamId64();
const currentYear = new Date().getFullYear();
const isHome = currentPath === '/';
const isInventory = currentPath === '/inventory';
const isGames = currentPath === '/games';
const canonicalUrl = new URL(Astro.url.pathname, SITE_CONFIG.url).href;
const ogImageUrl = new URL('/favicon.svg', SITE_CONFIG.url).href;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Discord / iMessage Embed Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="dns-prefetch" href="https://avatars.steamstatic.com" />
    <link rel="dns-prefetch" href="https://shared.cloudflare.steamstatic.com" />
    <link rel="dns-prefetch" href="https://cdn.cloudflare.steamstatic.com" />
  </head>
  <body class="flex min-h-screen flex-col bg-ink text-bone">
    <!-- Command Deck Modal Island (hydrates on idle to maximize FCP) -->
    <CommandDeck client:idle steamId={steamId} />

    <header class="sticky top-0 z-50 w-full border-b border-rule bg-ink/85 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-[1240px] items-center justify-between gap-4 px-5 sm:px-8">
        <a href="/" class="display shrink-0 text-[26px] text-bone" aria-label="huh4k home">
          huh4k<span class="text-signal">.</span>
        </a>

        <nav class="flex items-center gap-5 text-[15px] sm:gap-7" aria-label="Primary">
          {[
            { href: '/', label: 'links', active: isHome },
            { href: '/inventory', label: 'inventory', active: isInventory },
            { href: '/games', label: 'games', active: isGames },
          ].map((link) => (
            <a
              href={link.href}
              aria-current={link.active ? 'page' : undefined}
              class={`py-1 transition-colors ${link.active ? 'text-bone shadow-[0_2px_0_0_#ff6a1a]' : 'text-ash hover:text-bone'}`}
            >
              {link.label}
            </a>
          ))}
          <a href="/leetify" target="_blank" rel="noopener noreferrer" class="hidden py-1 text-ash transition-colors hover:text-bone md:inline">
            leetify<span class="text-ash-dim"> ↗</span>
          </a>
          <a href="https://github.com/huh4k" target="_blank" rel="noopener noreferrer" class="hidden py-1 text-ash transition-colors hover:text-bone md:inline">
            github<span class="text-ash-dim"> ↗</span>
          </a>
        </nav>

        <div class="flex shrink-0 items-center gap-4">
          <SteamPresence client:load variant="badge" className="hidden sm:flex" />
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-command-deck'))"
            class="hidden items-center gap-2 text-ash transition-colors hover:text-bone sm:inline-flex"
            title="Jump to… (press /)"
          >
            <span class="text-[13px]">jump to</span>
            <span class="kbd">/</span>
          </button>
        </div>
      </div>
    </header>

    <main class="relative z-10 mx-auto w-full max-w-[1240px] flex-1 px-5 pb-16 pt-8 sm:px-8 sm:pt-12">
      <slot />
    </main>

    <footer class="relative z-10 border-t border-rule">
      <div class="mx-auto max-w-[1240px] px-5 py-12 sm:px-8 sm:py-16">
        <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
          <p class="display text-[clamp(2.75rem,8vw,6.5rem)] text-bone">
            links and shit<span class="text-signal">.</span>
          </p>
          <SocialLinks />
        </div>

        <div class="num mt-12 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-rule pt-5 text-[11px] uppercase tracking-[0.12em] text-ash">
          <span>© {currentYear} huh4k</span>
          <span id="hud-clock" class="tabular-nums">--:--:-- AEST</span>
        </div>
      </div>
    </footer>

    <!-- Local clock: Sydney/Melbourne time, labelled AEST or AEDT depending on daylight saving -->
    <script is:inline>
      (function () {
        var fmt = new Intl.DateTimeFormat('en-AU', {
          timeZone: 'Australia/Sydney',
          hour: '2-digit', minute: '2-digit', second: '2-digit',
          hourCycle: 'h23',
          timeZoneName: 'short',
        });
        function tick() {
          var el = document.getElementById('hud-clock');
          if (!el) return;
          var t = {};
          fmt.formatToParts(new Date()).forEach(function (p) { t[p.type] = p.value; });
          var zone = /^(AEST|AEDT)$/.test(t.timeZoneName) ? t.timeZoneName : (t.timeZoneName || 'AEST');
          el.textContent = t.hour + ':' + t.minute + ':' + t.second + ' ' + zone;
        }
        tick();
        setInterval(tick, 1000);
      })();
    </script>
  </body>
</html>
