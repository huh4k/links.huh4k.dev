---
import { getSteamId64 } from '../lib/steam';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const steamId = getSteamId64();

const links = [
  { label: 'steam', href: `https://steamcommunity.com/profiles/${steamId}`, external: true },
  { label: 'leetify', href: '/leetify', external: true },
  { label: 'github', href: 'https://github.com/huh4k', external: true },
  { label: 'inventory', href: '/inventory', external: false },
  { label: 'games', href: '/games', external: false },
];
---

<ul class={`flex flex-wrap gap-x-6 gap-y-2 text-[15px] ${className}`}>
  {links.map((link) => (
    <li>
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
        class="u-link text-bone-soft hover:text-bone"
      >
        {link.label}{link.external && <span class="text-ash-dim"> ↗</span>}
      </a>
    </li>
  ))}
</ul>
