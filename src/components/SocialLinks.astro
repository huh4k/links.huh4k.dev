---
import { SITE_CONFIG } from '../lib/config';
import { getSteamId64 } from '../lib/steam';

interface Props {
  className?: string;
  showLabels?: boolean;
}

const { className = '', showLabels = false } = Astro.props;
const steamId = getSteamId64();
const steamProfileUrl = `https://steamcommunity.com/profiles/${steamId}`;
---

<div class={`flex items-center flex-wrap gap-2 ${className}`}>
  <!-- Steam -->
  <a
    href={steamProfileUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 p-2.5 rounded-lg border border-dark-border bg-dark-card hover:border-zinc-600 hover:bg-dark-card-hover text-zinc-300 hover:text-white transition-colors"
    aria-label="Steam Community Profile"
    title="Steam Profile"
  >
    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
      <path
        d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.005.105.005.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.704L.439 15.05C1.724 20.245 6.41 24 11.979 24c6.627 0 12-5.373 12-12s-5.373-12-12-12zM8.366 18.253l-1.92-.794c.264.44.662.779 1.15.957.962.35 2.03-.133 2.38-1.096.175-.483.136-.998-.073-1.424l-1.537 2.357zm7.576-6.315c-1.656 0-3.003-1.345-3.003-3.001 0-1.655 1.347-3.002 3.003-3.002 1.654 0 3.002 1.347 3.002 3.002 0 1.656-1.348 3.001-3.002 3.001zm-5.467 4.108c-.287.41-.74.686-1.266.746l1.503-2.306c.015.012.03.024.045.039.467.466.52 1.187-.282 1.521z"
      ></path>
    </svg>
    {showLabels && <span class="text-xs font-mono">Steam</span>}
  </a>

  <!-- GitHub -->
  <a
    href={SITE_CONFIG.author.github}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 p-2.5 rounded-lg border border-dark-border bg-dark-card hover:border-zinc-600 hover:bg-dark-card-hover text-zinc-300 hover:text-white transition-colors"
    aria-label="GitHub Profile"
    title="GitHub"
  >
    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
      ></path>
    </svg>
    {showLabels && <span class="text-xs font-mono">GitHub</span>}
  </a>

  <!-- LinkedIn -->
  <a
    href={SITE_CONFIG.author.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 p-2.5 rounded-lg border border-dark-border bg-dark-card hover:border-zinc-600 hover:bg-dark-card-hover text-zinc-300 hover:text-white transition-colors"
    aria-label="LinkedIn Profile"
    title="LinkedIn"
  >
    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
      <path
        d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
      ></path>
    </svg>
    {showLabels && <span class="text-xs font-mono">LinkedIn</span>}
  </a>

  <!-- Portfolio / Main Website -->
  <a
    href={SITE_CONFIG.author.portfolio}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 p-2.5 rounded-lg border border-dark-border bg-dark-card hover:border-zinc-600 hover:bg-dark-card-hover text-zinc-300 hover:text-white transition-colors"
    aria-label="Main Portfolio"
    title="huh4k.dev Portfolio"
  >
    <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    {showLabels && <span class="text-xs font-mono">Portfolio</span>}
  </a>

  <!-- Email -->
  <a
    href={`mailto:${SITE_CONFIG.author.email}`}
    class="inline-flex items-center gap-2 p-2.5 rounded-lg border border-dark-border bg-dark-card hover:border-zinc-600 hover:bg-dark-card-hover text-zinc-300 hover:text-white transition-colors"
    aria-label="Send Email"
    title="Email"
  >
    <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect width="20" height="16" x="2" y="4" rx="2"></rect>
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
    </svg>
    {showLabels && <span class="text-xs font-mono">Email</span>}
  </a>
</div>
