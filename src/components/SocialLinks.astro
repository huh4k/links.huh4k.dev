---
import { getSteamId64 } from '../lib/steam';

interface Props {
  className?: string;
  showLabels?: boolean;
}

const { className = '', showLabels = true } = Astro.props;
const steamId = getSteamId64();
const steamProfileUrl = `https://steamcommunity.com/profiles/${steamId}`;
const steamInventoryUrl = `https://steamcommunity.com/profiles/${steamId}/inventory/`;
---

<div class={`flex items-center flex-wrap gap-2 sm:gap-2.5 ${className}`}>
  <!-- Steam Community Node -->
  <a
    href={steamProfileUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-hardware bg-[#0F1118] hover:border-telemetry-blue/60 hover:bg-[#151824] text-zinc-300 hover:text-white transition-all text-xs font-mono font-medium tactile-btn shadow-sm"
    aria-label="Steam Profile"
    title="Steam Profile Uplink"
  >
    <svg class="w-3.5 h-3.5 fill-current text-telemetry-blue" viewBox="0 0 24 24">
      <path
        d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.005.105.005.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.704L.439 15.05C1.724 20.245 6.41 24 11.979 24c6.627 0 12-5.373 12-12s-5.373-12-12-12zM8.366 18.253l-1.92-.794c.264.44.662.779 1.15.957.962.35 2.03-.133 2.38-1.096.175-.483.136-.998-.073-1.424l-1.537 2.357zm7.576-6.315c-1.656 0-3.003-1.345-3.003-3.001 0-1.655 1.347-3.002 3.003-3.002 1.654 0 3.002 1.347 3.002 3.002 0 1.656-1.348 3.001-3.002 3.001zm-5.467 4.108c-.287.41-.74.686-1.266.746l1.503-2.306c.015.012.03.024.045.039.467.466.52 1.187-.282 1.521z"
      ></path>
    </svg>
    {showLabels && <span>[STEAM]</span>}
  </a>

  <!-- Leetify Analytics Node -->
  <a
    href="/leetify"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-[#BF3B68]/35 bg-[#BF3B68]/15 hover:border-[#BF3B68] hover:bg-[#BF3B68]/25 text-[#BF3B68] hover:text-white transition-all text-xs font-mono font-medium tactile-btn shadow-sm"
    aria-label="Leetify CS2 Profile"
    title="Leetify CS2 Analytics"
  >
    <svg class="w-3.5 h-3.5 fill-current text-[#BF3B68]" viewBox="0 0 24 24">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
    </svg>
    {showLabels && <span>[LEETIFY]</span>}
  </a>

  <!-- GitHub Source Node -->
  <a
    href="https://github.com/huh4k"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-hardware bg-[#0F1118] hover:border-zinc-400 hover:bg-[#151824] text-zinc-300 hover:text-white transition-all text-xs font-mono font-medium tactile-btn shadow-sm"
    aria-label="GitHub Profile"
    title="GitHub Source Repositories"
  >
    <svg class="w-3.5 h-3.5 fill-current text-zinc-300" viewBox="0 0 24 24">
      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
    </svg>
    {showLabels && <span>[GITHUB]</span>}
  </a>

  <!-- Steam Inventory Node -->
  <a
    href={steamInventoryUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-hardware bg-[#0F1118] hover:border-telemetry-amber/60 hover:bg-[#151824] text-zinc-300 hover:text-white transition-all text-xs font-mono font-medium tactile-btn shadow-sm"
    aria-label="Steam Inventory"
    title="Steam CS2 Inventory & Items"
  >
    <svg class="w-3.5 h-3.5 text-telemetry-amber" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
      <line x1="12" y1="22.08" x2="12" y2="12"></line>
    </svg>
    {showLabels && <span>[INVENTORY]</span>}
  </a>

  <!-- Games Library Node -->
  <a
    href="/games"
    class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-telemetry-blue/30 bg-telemetry-blue/10 hover:border-telemetry-blue/60 hover:bg-telemetry-blue/20 text-telemetry-blue hover:text-white transition-all text-xs font-mono font-medium tactile-btn shadow-sm"
    aria-label="Steam Games Shelf"
    title="Steam Games Library"
  >
    <svg class="w-3.5 h-3.5 text-telemetry-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="2" y="6" width="20" height="12" rx="2"></rect>
      <path d="M6 12h4m-2-2v4m7-2h.01m3 0h.01"></path>
    </svg>
    {showLabels && <span>[GAMES]</span>}
  </a>
</div>
