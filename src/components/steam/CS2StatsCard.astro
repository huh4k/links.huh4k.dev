---
import { getCS2Stats, type CS2RatingData } from '../../lib/leetify';
import StatBadge from './StatBadge.astro';

interface Props {
  steamId?: string;
  className?: string;
  stats?: CS2RatingData;
}

const { steamId, className = '', stats: propStats } = Astro.props;

const stats: CS2RatingData = propStats || (await getCS2Stats(steamId));
const { bracket } = stats;

// Format relative date for last match
function formatLastMatch(isoString: string | null): string {
  if (!isoString) return 'Recent';
  try {
    const date = new Date(isoString);
    const diffMs = Date.now() - date.getTime();
    const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
    if (diffHours < 1) return 'Just now';
    if (diffHours < 24) return `${diffHours}h ago`;
    const diffDays = Math.floor(diffHours / 24);
    if (diffDays === 1) return 'Yesterday';
    if (diffDays < 30) return `${diffDays}d ago`;
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  } catch {
    return 'Recent';
  }
}

const lastMatchFormatted = formatLastMatch(stats.lastMatchAt);
const leetifyFormatted =
  stats.leetifyRating !== null
    ? `${stats.leetifyRating > 0 ? '+' : ''}${stats.leetifyRating}`
    : '--';
const leetifyVariant = stats.leetifyRating && stats.leetifyRating > 0 ? 'leetify' : 'zinc';

// Compute tier advancement progress
const rating = stats.premierRating || 0;
const tierFloor = Math.floor(rating / 5000) * 5000;
const nextTierTarget = tierFloor + 5000;
const pointsInTier = Math.max(0, rating - tierFloor);
const progressPercent = rating >= 30000 ? 100 : Math.min(100, Math.max(0, Math.round((pointsInTier / 5000) * 100)));
const pointsNeeded = Math.max(0, nextTierTarget - rating);

const tierNames: Record<number, string> = {
  5000: 'Light Blue',
  10000: 'Blue',
  15000: 'Purple',
  20000: 'Pink',
  25000: 'Red',
  30000: 'Gold',
};
const nextTierName = tierNames[nextTierTarget] || 'Peak Tier';
---

<div
  class={`rounded-2xl border border-hardware bg-[#0F1118] p-5 sm:p-6 relative overflow-hidden telemetry-card shadow-xl ${className}`}
>
  <div class="absolute inset-0 bg-grid-pattern opacity-25 pointer-events-none"></div>

  <div class="relative z-10 flex flex-col justify-between h-full gap-5">
    <!-- Header -->
    <div class="flex items-center justify-between gap-3 border-b border-[#1E2333] pb-3">
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-telemetry-magenta shadow-sm shadow-[#BF3B68]/60"></span>
        <span class="text-xs font-mono font-bold tracking-wider text-white uppercase">
          [CS2 // PREMIER PERFORMANCE]
        </span>
      </div>

      <a
        href={stats.profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-[#BF3B68]/40 bg-[#BF3B68]/15 hover:border-[#BF3B68] hover:bg-[#BF3B68]/25 text-[11px] font-mono font-semibold text-[#BF3B68] hover:text-white transition-all tactile-btn"
        aria-label="View CS2 profile on Leetify"
        title="Open Leetify Profile"
      >
        <span>Leetify Profile</span>
        <span>↗</span>
      </a>
    </div>

    <!-- Rating Display Card -->
    <div
      class={`rounded-xl border p-4 sm:p-5 flex flex-col gap-4 relative overflow-hidden ${bracket.bgColor} ${bracket.borderColor} ${bracket.glowColor} shadow-md`}
    >
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-400">
              Counter-Strike 2 Premier
            </span>
            <span
              class={`text-[10px] font-mono px-2 py-0.5 rounded border ${bracket.borderColor} ${bracket.textColor} bg-black/60 font-bold tracking-wider`}
            >
              {bracket.name.toUpperCase()} TIER
            </span>
          </div>

          <div class="flex items-baseline gap-2">
            <span class={`text-3xl sm:text-5xl font-black font-mono tracking-tight ${bracket.textColor}`}>
              {stats.formattedPremier}
            </span>
            {stats.premierRating !== null && stats.premierRating > 0 && (
              <span class="text-xs font-mono text-zinc-400 font-semibold uppercase">
                pts
              </span>
            )}
          </div>
        </div>

        <div class="sm:text-right font-mono text-xs text-zinc-400 sm:border-l sm:border-white/10 sm:pl-4 space-y-0.5">
          <div class="text-[11px] text-zinc-200 font-semibold">{stats.recentMatchesCount} Matches Recorded</div>
          <div class="text-[10px] text-zinc-400">Competitive Status: {stats.statusLabel}</div>
        </div>
      </div>

      <!-- Tier Promotion Progress Bar -->
      <div class="space-y-1.5 pt-2 border-t border-white/10">
        <div class="flex items-center justify-between text-[11px] font-mono">
          <span class="text-zinc-300 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-telemetry-magenta"></span>
            <span>Next Rank: {nextTierName} Tier</span>
          </span>
          <span class="text-zinc-400 font-medium">
            {rating >= 30000 ? 'Peak Tier Reached' : `${new Intl.NumberFormat('en-US').format(pointsNeeded)} pts to rank up`}
          </span>
        </div>

        <div class="w-full h-2 rounded bg-black/60 border border-white/10 overflow-hidden relative">
          <div
            class="h-full bg-gradient-to-r from-telemetry-magenta via-purple-500 to-telemetry-blue transition-all duration-700 rounded-sm"
            style={`width: ${progressPercent}%`}
          ></div>
        </div>

        <div class="flex items-center justify-between text-[10px] font-mono text-zinc-500">
          <span>{new Intl.NumberFormat('en-US').format(tierFloor)} pts</span>
          <span>{progressPercent}% tier progress</span>
          <span>{new Intl.NumberFormat('en-US').format(nextTierTarget)} pts</span>
        </div>
      </div>
    </div>

    <!-- Secondary Metrics (Aim Score, Leetify Rating, Win Rate) -->
    <div class="grid grid-cols-3 gap-2.5 sm:gap-3">
      <StatBadge
        label="AIM SCORE"
        value={stats.aimRating !== null ? stats.aimRating : '--'}
        sublabel="/ 100"
        variant="purple"
      />
      <StatBadge
        label="LEETIFY RATING"
        value={leetifyFormatted}
        sublabel="SCORE"
        variant={leetifyVariant}
      />
      <StatBadge
        label="WIN RATE"
        value={stats.winRate !== null ? `${stats.winRate}%` : '--'}
        sublabel="RECENT"
        variant="sky"
      />
    </div>

    <!-- Footer Attribution -->
    <div class="pt-2.5 border-t border-[#1E2333] flex items-center justify-between text-[11px] font-mono text-zinc-500">
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-telemetry-green"></span>
        <span>Synced via Leetify • Last match {lastMatchFormatted}</span>
      </span>

      <span class="text-zinc-500 hidden sm:inline">CS2 Competitive</span>
    </div>
  </div>
</div>
