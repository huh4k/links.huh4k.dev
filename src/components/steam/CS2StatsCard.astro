---
import { getCS2Stats, type CS2RatingData } from '../../lib/leetify';

interface Props {
  steamId?: string;
  className?: string;
  stats?: CS2RatingData;
}

const { steamId, className = '', stats: propStats } = Astro.props;

const stats: CS2RatingData = propStats || (await getCS2Stats(steamId));
// Format relative date for last match
function formatLastMatch(isoString: string | null): string {
  if (!isoString) return 'recently';
  try {
    const date = new Date(isoString);
    const diffMs = Date.now() - date.getTime();
    const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
    if (diffHours < 1) return 'just now';
    if (diffHours < 24) return `${diffHours}h ago`;
    const diffDays = Math.floor(diffHours / 24);
    if (diffDays === 1) return 'yesterday';
    if (diffDays < 30) return `${diffDays}d ago`;
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  } catch {
    return 'recently';
  }
}

const lastMatchFormatted = formatLastMatch(stats.lastMatchAt);
const leetifyFormatted =
  stats.leetifyRating !== null
    ? `${stats.leetifyRating > 0 ? '+' : ''}${stats.leetifyRating}`
    : '--';
const leetifyVariant = stats.leetifyRating && stats.leetifyRating > 0 ? 'leetify' : 'zinc';

// Premier ladder (official tier colours, slightly warmed to sit on the page)
const rating = stats.premierRating || 0;
const TIERS = [
  { name: 'gray',       floor: 0,     ceil: 4999,  color: '#8f8b80' },
  { name: 'light blue', floor: 5000,  ceil: 9999,  color: '#7cc4f2' },
  { name: 'blue',       floor: 10000, ceil: 14999, color: '#4f86f7' },
  { name: 'purple',     floor: 15000, ceil: 19999, color: '#a86df2' },
  { name: 'pink',       floor: 20000, ceil: 24999, color: '#ec63b0' },
  { name: 'red',        floor: 25000, ceil: 29999, color: '#ee5148' },
  { name: 'gold',       floor: 30000, ceil: 99999, color: '#f4bd3e' },
];
const currentTier = TIERS.find((t) => rating >= t.floor && rating <= t.ceil) || TIERS[0];
const nextTier = TIERS[TIERS.indexOf(currentTier) + 1];
const pointsNeeded = nextTier ? Math.max(0, nextTier.floor - rating) : 0;
const fillFor = (t: (typeof TIERS)[number]) =>
  rating >= t.ceil + 1 ? 100 : rating < t.floor ? 0 : ((rating - t.floor) / (t.ceil + 1 - t.floor)) * 100;
const hasRating = stats.premierRating !== null && stats.premierRating > 0;
const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);

const rows = [
  { label: 'aim', value: stats.aimRating !== null ? String(stats.aimRating) : '–', unit: '/ 100' },
  { label: 'leetify rating', value: leetifyFormatted, unit: stats.leetifyRating && stats.leetifyRating > 0 ? 'above avg' : '' },
  { label: 'win rate', value: stats.winRate !== null ? `${stats.winRate}%` : '–', unit: 'recent' },
];
---

<section class={className} aria-label="Counter-Strike 2 Premier rating">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <!-- the number -->
    <div class="lg:col-span-7">
      <p class="eyebrow flex items-center gap-3">
        <span>cs2 premier</span>
        {hasRating && (
          <span class="flex items-center gap-2" style={`color:${currentTier.color}`}>
            <span class="inline-block h-1.5 w-1.5 rounded-full" style={`background:${currentTier.color}`}></span>
            {currentTier.name}
          </span>
        )}
      </p>

      <p
        class="display mt-4 text-[clamp(5.25rem,16vw,11.5rem)] leading-[0.82] [font-variant-numeric:tabular-nums]"
        style={`color:${hasRating ? currentTier.color : 'var(--bone)'}`}
      >
        {stats.formattedPremier}
      </p>

      <p class="mt-5 max-w-md text-[17px] leading-snug text-bone-soft">
        {hasRating
          ? nextTier
            ? <><span class="num text-bone">{fmt(pointsNeeded)}</span> points to {nextTier.name}.</>
            : 'top of the ladder.'
          : 'unranked this season.'}
        <span class="text-ash"> {stats.recentMatchesCount} matches on record.</span>
      </p>
    </div>

    <!-- the rest of the numbers -->
    <div class="lg:col-span-5 lg:pt-7">
      <dl>
        {rows.map((row) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-rule py-4 first:border-t">
            <dt class="text-[15px] text-ash">{row.label}</dt>
            <dd class="flex items-baseline gap-2">
              <span class="display text-[clamp(2.25rem,4vw,3.25rem)] [font-variant-numeric:tabular-nums]">{row.value}</span>
              {row.unit && <span class="num text-[11px] uppercase tracking-[0.1em] text-ash-dim">{row.unit}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <!-- ladder -->
  <div class="mt-14" aria-hidden="true">
    <div class="flex gap-1.5">
      {TIERS.map((t) => {
        const fill = fillFor(t);
        const isCurrent = t === currentTier && hasRating;
        return (
          <div class="relative flex-1">
            {isCurrent && (
              <span
                class="absolute -top-2.5 h-0 w-0 -translate-x-1/2 border-x-[5px] border-t-[6px] border-x-transparent"
                style={`left:${fill}%; border-top-color:${t.color}`}
              ></span>
            )}
            <div class="h-2 w-full overflow-hidden bg-ink-4">
              <div class="h-full" style={`width:${fill}%; background:${t.color}`}></div>
            </div>
            <p class="num mt-2 text-[10px] text-ash-dim">{t.floor === 0 ? '0' : `${t.floor / 1000}k`}</p>
          </div>
        );
      })}
    </div>
  </div>

  <p class="num mt-8 text-[11px] uppercase tracking-[0.12em] text-ash">
    last match {lastMatchFormatted} ·
    <a href={stats.profileUrl} target="_blank" rel="noopener noreferrer" class="u-link text-bone-soft hover:text-bone">via leetify ↗</a>
  </p>
</section>
