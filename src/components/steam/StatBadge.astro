---
interface Props {
  label: string;
  value: string | number;
  sublabel?: string;
  variant?: 'emerald' | 'sky' | 'purple' | 'zinc' | 'amber' | 'rose' | 'fuchsia' | 'leetify';
  className?: string;
}

const {
  label,
  value,
  sublabel,
  variant = 'zinc',
  className = '',
} = Astro.props;

const colorClasses = {
  emerald: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400',
  sky: 'border-sky-500/30 bg-sky-500/10 text-sky-400',
  purple: 'border-purple-500/30 bg-purple-500/10 text-purple-400',
  fuchsia: 'border-fuchsia-500/30 bg-fuchsia-500/10 text-fuchsia-400',
  amber: 'border-amber-500/30 bg-amber-500/10 text-amber-300',
  rose: 'border-rose-500/30 bg-rose-500/10 text-rose-400',
  leetify: 'border-[#BF3B68]/35 bg-[#BF3B68]/15 text-[#BF3B68]',
  zinc: 'border-dark-border bg-[#121520] text-zinc-300',
};

const badgeClass = colorClasses[variant] || colorClasses.zinc;
---

<div
  class={`flex flex-col justify-between p-3 rounded-xl border ${badgeClass} transition-all duration-200 hover:border-zinc-600/60 ${className}`}
>
  <span class="text-[11px] font-mono text-zinc-400 uppercase tracking-wider truncate mb-1">
    {label}
  </span>
  <div class="flex items-baseline gap-1.5">
    <span class="text-xl sm:text-2xl font-bold font-mono tracking-tight text-white">
      {value}
    </span>
    {sublabel && (
      <span class="text-[11px] font-mono text-zinc-500">
        {sublabel}
      </span>
    )}
  </div>
</div>
