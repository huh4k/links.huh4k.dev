---
/**
 * CS2 Loadout Showcase Astro Wrapper
 *
 * Mounts the interactive React island CS2LoadoutCard (Module C-2 in Homepage Bento Grid).
 * Features 5 authentic weapon slots, interactive 3D model inspect stage,
 * segmented float wear bar, paint seed badge, rarity styling, and [VIEW ALL SKINS] →
 * button routing to /inventory.
 */
import CS2LoadoutCard, { DEFAULT_LOADOUT_WEAPONS } from './CS2LoadoutCard';

interface Props {
  steamInventoryUrl?: string;
  className?: string;
}

const {
  steamInventoryUrl = 'https://steamcommunity.com/profiles/76561198920486334/inventory/',
  className = '',
} = Astro.props;
---

<CS2LoadoutCard
  client:visible
  weapons={DEFAULT_LOADOUT_WEAPONS}
  steamInventoryUrl={steamInventoryUrl}
  className={className}
/>

<noscript>
  <div class="rounded-2xl border border-hardware bg-[#0F1118] p-5 sm:p-6 text-zinc-400 font-mono text-xs space-y-3">
    <div class="flex items-center justify-between border-b border-[#1E2333] pb-2 text-white font-bold">
      <span>[CS2 // LOADOUT]</span>
      <span class="text-telemetry-amber">JavaScript Required for 3D Inspect</span>
    </div>
    <p class="text-zinc-500">
      Featured Weapons: AK-47 Ice Coaled (MW, Float: 0.0825), StatTrak™ M4A1-S Liquidation (FT, Float: 0.3438), AWP Ice Coaled (FN, Float: 0.0631), USP-S Royal Guard (FN, Float: 0.0560), ★ Karambit Doppler (FN, Float: 0.0089).
    </p>
    <div class="pt-2 flex items-center justify-between">
      <a href="/inventory" class="text-telemetry-blue hover:underline font-bold">
        [VIEW ALL SKINS] →
      </a>
      <a href={steamInventoryUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-white">
        Steam Inventory ↗
      </a>
    </div>
  </div>
</noscript>
